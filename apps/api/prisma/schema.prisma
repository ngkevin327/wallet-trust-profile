generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileVisibility {
  public
  private
}

enum SubscriptionTier {
  free
  premium
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  email             String?          @db.VarChar(255)
  subscriptionTier  SubscriptionTier @default(free) @map("subscription_tier")

  wallets  Wallet[]
  profile  Profile?

  @@map("users")
}

enum IndexRunStatus {
  pending
  running
  completed
  failed
}

model Wallet {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  address    String   @db.VarChar(42)
  chainScope String[] @map("chain_scope")
  isPrimary  Boolean  @default(false) @map("is_primary")
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  indexRuns         IndexRun[]
  transactionFacts  TransactionFact[]

  @@unique([address, chainScope])
  @@index([userId])
  @@map("wallets")
}

model IndexRun {
  id          String         @id @default(uuid()) @db.Uuid
  walletId    String         @map("wallet_id") @db.Uuid
  status      IndexRunStatus @default(pending)
  fromBlock   BigInt?        @map("from_block")
  toBlock     BigInt?        @map("to_block")
  startedAt   DateTime?      @map("started_at") @db.Timestamptz
  completedAt DateTime?      @map("completed_at") @db.Timestamptz
  error       String?        @db.Text

  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactionFacts TransactionFact[]
  scoreSnapshots   ScoreSnapshot[]

  @@index([walletId, status])
  @@map("index_runs")
}

model TransactionFact {
  id         String    @id @default(uuid()) @db.Uuid
  walletId   String    @map("wallet_id") @db.Uuid
  indexRunId String?   @map("index_run_id") @db.Uuid
  chainId    Int       @map("chain_id")
  txHash     String    @map("tx_hash") @db.VarChar(66)
  logIndex   Int?      @map("log_index")
  blockTime  DateTime  @map("block_time") @db.Timestamptz
  category   String    @db.VarChar(64)
  protocolId String?   @map("protocol_id") @db.Uuid
  raw        Json      @db.JsonB

  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  indexRun IndexRun? @relation(fields: [indexRunId], references: [id], onDelete: SetNull)

  @@unique([chainId, txHash, logIndex])
  @@index([walletId, blockTime(sort: Desc)])
  @@map("transaction_facts")
}

model Profile {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @map("user_id") @db.Uuid
  slug                String            @unique @db.VarChar(64)
  displayName         String?           @map("display_name") @db.VarChar(128)
  visibility          ProfileVisibility @default(public)
  publicCacheVersion  Int               @default(0) @map("public_cache_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}
