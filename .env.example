# Application
NODE_ENV=development
PORT=3001
API_MOCK_MODE=true

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://reputation:reputation@localhost:5432/reputation

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ANONYMOUS_PER_MIN=60

# API / auth (set in staging via Secrets Manager)
JWT_ISSUER=onchain-reputation
JWT_AUDIENCE=onchain-reputation-api

# External providers (never commit real keys)
ALCHEMY_API_KEY=
RPC_URL_ETHEREUM=
RPC_URL_BASE=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
