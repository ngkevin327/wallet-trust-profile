# Application
NODE_ENV=development
PORT=3001
API_MOCK_MODE=true
ADMIN_API_KEY=dev-admin-key-change-me

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://reputation:reputation@localhost:5432/reputation

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ANONYMOUS_PER_MIN=60

# API / auth (set in staging via Secrets Manager)
JWT_ISSUER=onchain-reputation
JWT_AUDIENCE=onchain-reputation-api
# Auto-generated on first run by: pnpm setup:local
# Or manually: node apps/api/scripts/generate-dev-jwt-keys.mjs
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000

# External providers (never commit real keys)
ALCHEMY_API_KEY=
RPC_URL_ETHEREUM=
RPC_URL_BASE=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# WalletConnect Cloud project id (https://cloud.walletconnect.com) — optional if using a browser extension wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SIWE_DOMAIN=localhost
# Set to "true" to open /dashboard and /settings without SIWE (local UI only)
# NEXT_PUBLIC_TEST_MODE=true
